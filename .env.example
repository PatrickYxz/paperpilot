# Copy this file to .env, replace credential placeholders, then export it into
# each API/Worker shell. PaperPilot does not load .env automatically.

# Model and external-service credentials
DEEPSEEK_API_KEY=sk-xxxx
DASHSCOPE_API_KEY=sk-xxxx
SEMANTIC_SCHOLAR_API_KEY=xxxx

# MCP process and data boundaries
MCP_TOOL_TIMEOUT=180
MCP_INITIALIZE_TIMEOUT=60
PAPERPILOT_GRAPH_PATH=data/graph/citation_graph.pkl

# Business data and LangGraph checkpoints; API and Worker must share both paths
PAPERPILOT_TASK_DB_PATH=data/web/tasks.sqlite3
PAPERPILOT_LANGGRAPH_CHECKPOINT_DB_PATH=data/langgraph/checkpoints.sqlite3
LANGGRAPH_STRICT_MSGPACK=true

# Local thread executor (default)
PAPERPILOT_TASK_EXECUTOR=thread
PAPERPILOT_THREAD_WORKERS=2
PAPERPILOT_THREAD_QUEUE_CAPACITY=4
PAPERPILOT_OVERLOAD_RETRY_AFTER_SECONDS=1

# Infrastructure retry policy shared by thread and Celery executors
PAPERPILOT_TASK_MAX_RETRIES=3
PAPERPILOT_TASK_RETRY_BACKOFF_SECONDS=1
PAPERPILOT_TASK_RETRY_BACKOFF_MAX_SECONDS=30

# Runtime observability
PAPERPILOT_LOG_LEVEL=INFO
PAPERPILOT_LOG_FORMAT=json
PAPERPILOT_SLOW_REQUEST_MS=1000
PAPERPILOT_ENV=development

# Celery alternative: uncomment these and replace the thread executor above
# PAPERPILOT_TASK_EXECUTOR=celery
# PAPERPILOT_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# PAPERPILOT_TASK_SOFT_TIME_LIMIT_SECONDS=10800
# PAPERPILOT_TASK_TIME_LIMIT_SECONDS=11100
# PAPERPILOT_REDIS_VISIBILITY_TIMEOUT_SECONDS=14400

# Bounded Conversation research runtime
PAPERPILOT_SUMMARY_TOKEN_THRESHOLD=32000
PAPERPILOT_SUMMARY_RECENT_TURNS=6
PAPERPILOT_RESEARCH_RECURSION_LIMIT=24
PAPERPILOT_RESEARCH_MODEL_CALL_LIMIT=8
PAPERPILOT_RESEARCH_TOOL_CALL_LIMIT=12
PAPERPILOT_RESEARCH_MAX_OUTPUT_TOKENS=4096
PAPERPILOT_RESEARCH_MODEL_RETRIES=1
