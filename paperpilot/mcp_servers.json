{
  "mcpServers": {
    "arxiv": {
      "command": "python",
      "args": ["-m", "paperpilot.mcp_servers.arxiv"]
    },
    "colbert": {
      "command": "python",
      "args": ["-m", "paperpilot.mcp_servers.colbert.server"],
      "env": {
        "HF_HUB_OFFLINE": "1"
      }
    },
    "graph": {
      "command": "python",
      "args": ["-m", "paperpilot.mcp_servers.graph.server"]
    },
    "vlm": {
      "command": "python",
      "args": ["-m", "paperpilot.mcp_servers.vlm.server"]
    }
  }
}
